# ==========================================
# APP
# ==========================================
APP_NAME="Sistema de Incidencias Georreferenciadas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

# ==========================================
# SYSTEM PORTS
# ==========================================
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ==========================================
# DATABASE
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=incidencias_db
DB_USERNAME=user
DB_PASSWORD=password

# ==========================================
# REDIS
# ==========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ==========================================
# SESSION
# ==========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==========================================
# CACHE & QUEUE
# ==========================================
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ==========================================
# LOGGING
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CORS
# Comma-separated list of allowed origins.
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# API
# ==========================================
API_VERSION=1.0.0

# ==========================================
# DOCKER IMAGES
# ==========================================
POSTGIS_IMAGE=postgis/postgis:17-3.5-alpine
REDIS_IMAGE=redis:8-alpine

# ==========================================
# RUSTFS HOST-SIDE PORT MAPPING
# These are the OUTER ports (on your host). Internal port is 9000/9001
# inside the docker network. See docs/PORTS.md for the allocation
# convention if running this alongside other projects (JASRAPO, FlowTory)
# that also use RustFS.
# ==========================================
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ==========================================
# OBSERVABILITY
# ==========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

# ==========================================
# CLOUDFLARE TUNNEL
# ==========================================
CLOUDFLARE_TUNNEL_TOKEN=

# ==========================================
# SONARQUBE (Static Code Analysis)
# ==========================================
# Port on the host for SonarQube UI (internal port is always 9000).
SONARQUBE_PORT=9002

# SonarQube's own database credentials.
# IMPORTANT: Generate a strong password — do not use defaults in production.
SONARQUBE_DB_DATABASE=sonarqube
SONARQUBE_DB_USERNAME=sonarqube
SONARQUBE_DB_PASSWORD=

# Docker image — pinned to a specific Community Build to avoid
# floating tags resolving to inactive builds during upgrades.
SONARQUBE_IMAGE=sonarqube:26.7.0.124771-community
SONARQUBE_DB_IMAGE=postgres:17-alpine
