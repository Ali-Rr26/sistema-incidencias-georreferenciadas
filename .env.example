# =============================================================
#  Sistema de Incidencias Georreferenciadas — .env.example
# =============================================================
#  Plantilla única. Espeja este archivo a `.env` (raíz) y editá
#  los valores. NO crear copias en subcarpetas — la fuente de
#  verdad es esta.
#
#  El runtime dentro de docker toma estas vars vía `env_file: .env`
#  en docker-compose.yml. El backend NO tiene un .env propio.
#
#  Secciones:
#    1.  Laravel core
#    2.  Database (PostgreSQL + PostGIS)
#    3.  Redis
#    4.  Storage (S3-compatible, RustFS en dev)
#    5.  JWT (auth backend)
#    6.  Mercure (real-time push para el bell de notifications)
#    7.  Firebase Admin SDK (login con Google)
#    8.  Mail
#    9.  CORS
#    10. Compose: ports + imágenes + observability
#
#  Marcadores:
#    🔴 = crítico / secreto. Rotar antes de prod.
#    🟡 = importante, valor por env.
#    🟢 = opcional, default razonable.
# =============================================================


# =============================================================
#  1.  Laravel core
# =============================================================

APP_NAME="Sistema de Incidencias Georreferenciadas"
APP_ENV=local                              # local | staging | production
APP_KEY=                                    # 🔴 Generar con `php artisan key:generate`
APP_DEBUG=true                              # 🟡 false en prod
APP_URL=http://localhost:3000               # 🟡 URL pública del frontend
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12                            # 🟢 cost factor del hash de passwords

LOG_CHANNEL=stack                          # stack | stderr_json | single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                             # debug | info | warning | error

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database           # alterna si querés maintenance vía DB

SESSION_DRIVER=cookie
SESSION_LIFETIME=120                        # minutos
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local                       # local | s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis                           # redis | file | database

OCTANE_SERVER=swoole                       # swoole (project default since ADR-0007)
API_VERSION=1.0.0


# =============================================================
#  2.  Database (PostgreSQL + PostGIS)
# =============================================================
#
# DB_PORT controla el puerto del HOST al que se mapea el contenedor
# Postgres (línea `${DB_PORT:-5432}:5432` del docker-compose). Es
# DISTINTO del puerto que ve el backend dentro de la red Docker, que
# siempre escucha en 5432 (fijo, interno).
#
# Rango aceptado: 5432–5435 (ver docs/Guias/PORTS.md — bloque DB :54xx).
#   5432 = primary (este stack)
#   5433, 5434, 5435 = reservados para stacks paralelos (JASRAPO-BACKEND,
#                      FlowTory, etc.). Elegí uno libre si vas a correr
#                      varios compose al mismo tiempo.

DB_CONNECTION=pgsql
DB_HOST=db                                  # 'db' (compose hostname) o 127.0.0.1 fuera de docker
DB_PORT=5432                                # 5432–5435 (puerto del host); default 5432
DB_DATABASE=incidencias_db
DB_USERNAME=user                            # 🔴 cambiar en prod
DB_PASSWORD=password                        # 🔴 cambiar en prod


# =============================================================
#  3.  Redis
# =============================================================

REDIS_CLIENT=phpredis                       # phpredis | predis
REDIS_HOST=redis                            # 'redis' o 127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null                         # 🔴 si lo activás

# REDIS_FEED_TTL_SECONDS: TTL (segundos) de las claves feed:v2:* en Redis
# (feed:v2:items, feed:v2:index) tras cada rebuild o sync. Tiene que ser
# entero positivo. Valores vacíos, no numéricos, cero o negativos caen al
# default documentado (604800 = 7 días) para evitar que Redis::expire
# borre las claves silenciosamente.
REDIS_FEED_TTL_SECONDS=


# =============================================================
#  4.  Storage (S3-compatible, RustFS en dev)
# =============================================================

# Storage: AWS_* is read by Laravel directly (S3 driver, filesystems
# cache, queue, StorageService). One source of truth, no rename at
# the deploy boundary. The deploy/compose passes them straight through.
AWS_ACCESS_KEY_ID=rustfsadmin              # 🔴 cambiar en prod
AWS_SECRET_ACCESS_KEY=rustfsadmin           # 🔴 cambiar en prod
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=incidencias
AWS_ENDPOINT=http://rustfs:9000             # 🟡 URL del endpoint S3
# true for MinIO/RustFS, false for real AWS S3.
AWS_USE_PATH_STYLE_ENDPOINT=true

# STORAGE_* son las credenciales con las que ARRANCA el contenedor
# RustFS (server S3). Coinciden con AWS_* en dev porque RustFS es
# ambos lados. En prod con AWS S3 real, STORAGE_* queda vacio (o no
# se usa) porque solo aplica a RustFS local. El deploy.yml las exige
# con `:?Variable ... requerida` para forzar el seteo explicito.
STORAGE_ACCESS_KEY=rustfsadmin              # 🔴 cambiar en prod (credenciales del server RustFS)
STORAGE_SECRET_KEY=rustfsadmin              # 🔴 cambiar en prod


# =============================================================
#  5.  JWT (auth backend)
# =============================================================
#  Generar con `openssl rand -base64 48` (mínimo 32 bytes).
#  Son 2 secrets distintos: rotar access NO invalida refresh tokens.

JWT_ACCESS_SECRET=                         # 🔴 32+ bytes random
JWT_REFRESH_SECRET=                         # 🔴 32+ bytes random, DISTINTO del access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# =============================================================
#  6.  Mercure (real-time push para el bell de notifications)
# =============================================================
#  Hay 2 secretos distintos:
#   - PUBLISHER: el backend lo usa para firmar publicaciones.
#     Compromete esto = inyecciones de notis falsas.
#   - SUBSCRIBER: el backend lo usa para firmar la cookie del browser.
#     Compromete esto = escuchas el stream de cualquier user hasta el TTL.
#
#  Procedimiento de rotación: docs/Security/secret-rotation.md
#  NO crear backend/.env — toda config va acá.



# =============================================================
#  7.  Firebase Admin SDK (login con Google)
# =============================================================

FIREBASE_CREDENTIALS=/var/www/backend/storage/auth-XXXXXX-firebase-adminsdk-fbsvc-YYYYYY.json  # 🔴 path al JSON de service account
FIREBASE_PROJECT_ID=auth-XXXXXX                                                       # 🟡 tu project ID
FIREBASE_LEEWAY_SECONDS=5                                                             # 🟢 tolerancia de clock skew


# =============================================================
#  8.  Mail (placeholder — en dev usa log driver)
# =============================================================

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────────
# Gmail / SMTP — From address for AssignmentNotification mail
# ──────────────────────────────────────────────────────────────────────
# Overrides opcionales del `from` para el canal de notificaciones de
# asignación. Si los valores GMAIL_FROM_* están vacíos, SmtpMailSender
# hace fallback automático a MAIL_FROM_ADDRESS / MAIL_FROM_NAME.
#
# Las credenciales SMTP (host, port, username, password, encryption)
# NO se setean acá: van en MAIL_HOST / MAIL_PORT / MAIL_USERNAME /
# MAIL_PASSWORD / MAIL_SCHEME más arriba. Symfony Mailer las lee
# directamente de config/mail.php → sección `mailers.smtp`.
# ──────────────────────────────────────────────────────────────────────
GMAIL_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
GMAIL_FROM_NAME="${MAIL_FROM_NAME}"

# ──────────────────────────────────────────────────────────────────────
#  User Invitations
# ──────────────────────────────────────────────────────────────────────
# INVITATION_TTL_HOURS: vigencia de la invitación en horas (default 48).
# TERMS_VERSION: versión actual de Términos y Condiciones. Cuando
#   exista un documento real, actualizar a v1, v2, etc.
# FRONTEND_BASE_URL: URL pública del frontend para construir el link de
#   aceptación en el mail. Si está vacía se usa APP_URL como fallback.

INVITATION_TTL_HOURS=48              # 🟢 TTL de invitación en horas
TERMS_VERSION=v0                     # 🟢 versión de T&C aceptada
FRONTEND_BASE_URL=                    # 🟢 vacío → usa APP_URL como fallback


# =============================================================
#  9.  CORS
# =============================================================

# 🟡 Orígenes permitidos. Coma-separado.
CORS_ALLOWED_ORIGINS=http://localhost:3000


# =============================================================
#  10. Compose: ports + imágenes + observability
# =============================================================
#  Estas vars son leídas SOLO por docker-compose. No son vars
#  de runtime de Laravel, pero viven acá para tener una sola
#  fuente de configuración del proyecto.

# Puertos (host → container)
FRONTEND_PORT=3000
BACKEND_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
SONARQUBE_PORT=9002                       # puerto host del UI/API

# Imágenes Docker (pinned para evitar floating tags)
POSTGIS_IMAGE=postgis/postgis:17-3.5-alpine
REDIS_IMAGE=redis:8-alpine
RUSTFS_IMAGE=rustfs/rustfs:latest
SONARQUBE_IMAGE=sonarqube:26.7.0.124771-community
SONARQUBE_DB_IMAGE=postgres:17-alpine

# SonarQube (Static Code Analysis)
# Stack propio, aislado del observability (Prometheus/Grafana/Loki).
# Levantar con: docker compose up -d sonarqube_db sonarqube
# Ver ops/sonarqube/README.md para instrucciones completas
# (incluido el requisito `vm.max_map_count >= 262144` en el host).
SONARQUBE_DB_DATABASE=sonarqube           # DB interna del stack SonarQube
SONARQUBE_DB_USERNAME=sonarqube           # 🔴 cambiar en prod
SONARQUBE_DB_PASSWORD=                    # 🔴 Generar con `openssl rand -base64 24`
SONARQUBE_DB_PORT=5432                    # puerto INTERNO del contenedor sonarqube_db

# CI (GitHub Actions): SONAR_TOKEN y SONAR_HOST_URL son GitHub repo
# secrets — NO van acá. Ver ops/sonarqube/README.md → "Exposing
# SonarQube for CI" para el setup con Cloudflare Tunnel.

# Cloudflared tunnel
CLOUDFLARE_TUNNEL_TOKEN=                    # 🔴 token del tunnel (no dejar el de dev en prod)
