# ==========================================
# SYSTEM PORTS
# ==========================================
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=incidencias_db
DB_USERNAME=user
DB_PASSWORD=password

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# DOCKER IMAGES
# ==========================================
NGINX_IMAGE=nginx:alpine
POSTGIS_IMAGE=postgis/postgis:17-3.5-alpine
REDIS_IMAGE=redis:8-alpine

# ==========================================
# CLOUDFLARE TUNNEL CONFIGURATION
# ==========================================
# Create a tunnel in the Cloudflare dashboard and copy the token here
CLOUDFLARE_TUNNEL_TOKEN=