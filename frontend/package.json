{
  "name": "sistema-incidencias-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"app/**/*.js\"",
    "lint:fix": "eslint \"app/**/*.js\" --fix",
    "format": "prettier --check \"app/**/*.{js,css,html}\" \"*.{json,js,cjs}\" \"index.html\"",
    "format:fix": "prettier --write \"app/**/*.{js,css,html}\" \"*.{json,js,cjs}\" \"index.html\"",
    "test": "vitest run --config vitest.config.js",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:coverage": "vitest run --config vitest.unit.config.js --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:snapshot": "vitest run --config vitest.snapshot.config.js",
    "test:watch": "vitest",
    "test:e2e:mobile": "playwright test --config=playwright.config.mobile.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
