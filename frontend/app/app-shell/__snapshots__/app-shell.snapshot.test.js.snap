exports[`appShell visual regression snapshots (T-3.8) > admin-mode renders the full chrome (header + admin sidebar + admin bottom nav) 1`] = `"<div class="app-shell"><header class="app-shell-header"><button type="button" class="app-shell-sidebar-toggle" id="app-shell-sidebar-toggle" aria-label="Alternar barra lateral" aria-controls="app-shell-sidebar" aria-expanded="true" title="Colapsar barra lateral"><i class="fa-solid fa-angles-left app-shell-sidebar-toggle__icon" aria-hidden="true"></i></button><div class="app-shell-header__brand"><i class="fa-solid fa-location-dot"></i><span class="app-shell-header__brand-name">GeoReporta</span></div><div class="app-shell-header__admin" data-show-on-role="admin"><div class="app-shell-header__search"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="form-control app-shell-header__search-input" placeholder="Buscar incidencia..."></div><button class="app-shell-header__icon-btn" aria-label="Notificaciones" id="app-shell-bell-admin" data-nav-target="/notificaciones"><i class="fa-regular fa-bell"></i><span class="app-shell-header__notif-badge d-none" id="app-shell-bell-badge-admin">0</span></button><button class="app-shell-header__icon-btn" aria-label="Configuración"><i class="fa-solid fa-gear"></i></button><div class="app-shell-user-menu"><button class="app-shell-user-menu__trigger" id="app-shell-user-menu-trigger" type="button" aria-haspopup="menu" aria-expanded="false"><span class="app-shell-user-menu__avatar" id="app-shell-user-avatar">A</span><span class="app-shell-user-menu__name" id="app-shell-user-name">Admin Root</span><i class="fa-solid fa-chevron-down app-shell-user-menu__arrow"></i></button><ul role="menu" id="app-shell-user-menu-panel" class="app-shell-user-menu__panel" hidden=""><li role="menuitem" tabindex="-1" id="app-shell-user-menu-profile" class="app-shell-user-menu__item"> Mi perfil </li><li role="menuitem" tabindex="-1" id="app-shell-user-menu-logout" class="app-shell-user-menu__item app-shell