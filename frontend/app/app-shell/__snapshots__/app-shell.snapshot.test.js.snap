exports[`appShell visual regression snapshots (T-3.8) > admin-mode renders the full chrome (header + admin sidebar + admin bottom nav) 1`] = `"<div class="app-shell"><header class="app-shell-header"><div class="app-shell-header__brand"><i class="fa-solid fa-location-dot"></i><span class="app-shell-header__brand-name">GeoReporta</span></div><div class="app-shell-header__admin" data-show-on-role="admin"><div class="app-shell-header__search"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="form-control app-shell-header__search-input" placeholder="Buscar incidencia..."></div><button class="app-shell-header__icon-btn" aria-label="Notificaciones" id="app-shell-bell-admin"><i class="fa-regular fa-bell"></i></button><button class="app-shell-header__icon-btn" aria-label="Configuración"><i class="fa-solid fa-gear"></i></button><button class="app-shell-user-menu__trigger" id="app-shell-user-menu-trigger" type="button" aria-haspopup="menu" aria-expanded="false"><span class="app-shell-user-menu__avatar" id="app-shell-user-avatar">U</span><span class="app-shell-user-menu__name" id="app-shell-user-name">Usuario</span><i class="fa-solid fa-chevron-down app-shell-user-menu__arrow"></i></button><ul role="menu" id="app-shell-user-menu-panel" class="app-shell-user-menu__panel" hidden=""><li role="menuitem" tabindex="-1" id="app-shell-user-menu-profile" class="app-shell-user-menu__item"> Mi perfil </li><li role="menuitem" tabindex="-1" id="app-shell-user-menu-logout" class="app-shell-user-menu__item app-shell-user-menu__item--logout" aria-disabled="false"> Cerrar sesión </li></ul></div><div class="app-shell-header__citizen" data-show-on-role="citizen"><button class="app-shell-header__bell" id="app-shell-bell" type="button" aria-label="Notificaciones"><i class="fa-regular fa-bell"></i></button><a class="app-shell-avatar" id="app-shell-avatar-link" href="#/configuracion/perfil"><span class="app-shell-avatar__letter" id="app-shell-avatar">?</span></a></div><a href="#/login" class="app-shell-login-btn" id="app-shell-login-btn" data-show-on-role="guest"> Ingresar </a></header><aside class="app-shell-sidebar"><nav class="app-shell-sidebar__nav" id="app-shell-admin-sidebar" data-show-on-role="admin"><ul class="app-shell-sidebar__list"><li class="app-shell-section"><span>PRINCIPAL</span></li><li><a href="#/dashboard" class="app-shell-nav-item" data-route="/dashboard"><i class="fa-solid fa-gauge-high"></i><span>Dashboard</span></a></li><li><a href="#/incidencias" class="app-shell-nav-item" data-route="/incidencias"><i class="fa-solid fa-clipboard-list"></i><span>Incidencias</span></a></li><li class="app-shell-section"><span>GESTIÓN</span></li><li><a href="#/usuarios" class="app-shell-nav-item" data-route="/usuarios"><i class="fa-solid fa-users"></i><span>Usuarios</span></a></li><li><a href="#/organizaciones" class="app-shell-nav-item" data-route="/organizaciones"><i class="fa-solid fa-building"></i><span>Organizaciones</span></a></li><li><a href="#/localizaciones" class="app-shell-nav-item" data-route="/localizaciones"><i class="fa-solid fa-map"></i><span>Localizaciones</span></a></li><li><a href="#/categorias" class="app-shell-nav-item" data-route="/categorias"><i class="fa-solid fa-tag"></i><span>Categorías</span></a></li><li class="app-shell-section"><span>CONFIGURACIÓN</span></li><li><a href="#/configuracion/perfil" class="app-shell-nav-item" data-route="/configuracion/perfil"><i class="fa-solid fa-user"></i><span>Perfil</span></a></li></ul></nav><nav class="app-shell-sidebar__nav" id="app-shell-citizen-sidebar" data-show-on-role="citizen"><ul class="app-shell-sidebar__list app-shell-sidebar__list--flat"><li><a href="#/feed" class="app-shell-nav-item" data-route="/feed"><i class="fa-solid fa-house"></i><span>Inicio</span></a></li><li><a href="#/mapa" class="app-shell-nav-item" data-route="/mapa"><i class="fa-solid fa-map-location-dot"></i><span>Mapa</span></a></li><li><a href="#/alertas" class="app-shell-nav-item" data-route="/aler