APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=incidencias_db
DB_USERNAME=user
DB_PASSWORD=password

OCTANE_SERVER=roadrunner

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════════════
# S3-compatible Storage — Almacenamiento de objetos
# ═══════════════════════════════════════════════════════════════════

# Host del servidor S3 (localhost para dev, rustfs/minio en Docker)
STORAGE_ENDPOINT=localhost
# Puerto del servidor S3
STORAGE_PORT=9000
# Usar SSL para la conexión
STORAGE_USE_SSL=false
# Access key para autenticación S3
STORAGE_ACCESS_KEY=
# Secret key para autenticación S3
STORAGE_SECRET_KEY=
# Nombre del bucket
STORAGE_BUCKET=incidencias
# Tiempo de expiración de URLs prefirmadas en horas
STORAGE_URL_EXPIRY_HOURS=24

# Laravel Filesystem — derivado de STORAGE_* (no tocar manualmente)
FILESYSTEM_STORAGE_DISK=s3
AWS_ACCESS_KEY_ID=${STORAGE_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${STORAGE_SECRET_KEY}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=${STORAGE_BUCKET}
AWS_ENDPOINT=http://${STORAGE_ENDPOINT}:${STORAGE_PORT}
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════════════
# JWT — Autenticación y tokens
# ═══════════════════════════════════════════════════════════════════

# Secreto para firmar tokens de acceso
# Generate: php -r "echo base64_encode(random_bytes(32));"
JWT_ACCESS_SECRET=
# Duración del token de acceso (15m, 1h, etc.)
JWT_ACCESS_EXPIRES_IN=15m

# Secreto para firmar tokens de refresh (distinto al de acceso)
# Generate: php -r "echo base64_encode(random_bytes(32));"
JWT_REFRESH_SECRET=
# Duración del token de refresh (7d, 30d, etc.)
JWT_REFRESH_EXPIRES_IN=7d

# ═══════════════════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════════════════

API_VERSION=1.0.0

# ═══════════════════════════════════════════════════════════════════
# Firebase Authentication — server-side service account (registro-y-google-auth)
# ═══════════════════════════════════════════════════════════════════
#
# Absolute path on the server to the service-account JSON downloaded from
# Firebase Console → Project settings → Service accounts → Generate new
# private key. NEVER commit the JSON itself to git — keep it at a path
# covered by .gitignore (e.g. backend/storage/firebase-service-account.json).
#
# Resolved by config('services.firebase.credentials_path') with a
# fallback to env('FIREBASE_CREDENTIALS') in AppServiceProvider.
# Leaving this empty throws RuntimeException on first /api/auth/google
# hit (intentional — fail loud, not silent).
#
FIREBASE_CREDENTIALS=

# Optional. Same value lives inside the JSON; setting it here lets you
# override for ops without re-downloading the key file.
FIREBASE_PROJECT_ID=

# Optional. Clock-skew tolerance in seconds for ID-token verification.
# Defaults to 5 (matches the Kreait SDK default).
FIREBASE_LEEWAY_SECONDS=5
